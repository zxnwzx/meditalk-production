# 반드시 새 무작위 값으로 교체하세요. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# SQLite 기본 모드에서는 Gunicorn 워커를 1개로 유지하세요.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
PUBLISH_POLL_SECONDS=2

# PostgreSQL·Redis·S3/R2 사용 시에만 설정합니다.
# DATABASE_URL=postgresql://user:password@host:5432/meditalk
# REDIS_URL=redis://host:6379/0
# S3_BUCKET=your-bucket
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE=https://cdn.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
